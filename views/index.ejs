<!doctype html>
<html lang="en">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SY3S7PSGDY"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SY3S7PSGDY');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Aaron Yangello is a software engineer building dependable systems, integrations, data products, and playful technical experiments.">
    <meta name="theme-color" content="#111318">
    <title>Aaron Yangello — Software Engineer</title>
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/site.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href="#top" aria-label="Aaron Yangello, home">
        <span class="brand-mark">AY</span>
        <span class="brand-role">AI-Native engineer</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span>Menu</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#archive">Archive</a>
        <a href="/resume.pdf" target="_blank" rel="noopener">Résumé</a>
        <a href="mailto:ayangello@gmail.com">Let’s talk</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-heading">
          <h1 id="hero-title" class="reveal">
            I turn complicated systems into <span>clear, useful software.</span>
          </h1>

          <div class="hero-diagram" aria-hidden="true">
            <svg viewBox="0 0 420 250" role="presentation">
              <defs>
                <linearGradient id="resolved-signal" x1="230" y1="125" x2="404" y2="74" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#111318" />
                  <stop offset="0.35" stop-color="#4059db" />
                  <stop offset="1" stop-color="#4059db" stop-opacity="0.18" />
                </linearGradient>
              </defs>

              <path class="diagram-guide" d="M128 28 C191 2 282 21 320 77 C365 143 325 221 245 232 C172 242 105 197 104 132 C103 84 111 52 128 28" />

              <path class="diagram-signal" d="M14 44 C72 13 96 91 149 77 C187 67 188 117 221 124" />
              <path class="diagram-signal" d="M8 119 C74 150 95 78 151 112 C179 129 193 129 221 125" />
              <path class="diagram-signal" d="M20 211 C69 229 96 151 146 170 C188 186 185 138 221 127" />
              <path class="diagram-signal diagram-signal-faint" d="M49 17 C61 71 112 57 125 105 C134 139 169 144 221 126" />

              <circle class="diagram-node" cx="14" cy="44" r="5" />
              <circle class="diagram-node" cx="8" cy="119" r="3" />
              <circle class="diagram-node" cx="20" cy="211" r="6" />
              <circle class="diagram-node diagram-node-small" cx="49" cy="17" r="2" />
              <circle class="diagram-node diagram-node-small" cx="94" cy="87" r="2" />
              <circle class="diagram-node diagram-node-small" cx="145" cy="170" r="2" />

              <g class="diagram-focus">
                <ellipse cx="226" cy="125" rx="52" ry="31" transform="rotate(-26 226 125)" />
                <ellipse cx="226" cy="125" rx="52" ry="31" transform="rotate(26 226 125)" />
                <circle class="diagram-focus-core" cx="226" cy="125" r="15" />
              </g>

              <path class="diagram-resolved" d="M226 125 C277 125 293 72 343 72 C372 72 386 91 408 91" />
              <circle class="diagram-output-dot" cx="343" cy="72" r="7" />
              <circle class="diagram-output-ring" cx="408" cy="91" r="9" />
              <path class="diagram-tick" d="M307 103 L315 111 M321 91 L329 99 M335 79 L343 87" />
            </svg>
          </div>
        </div>
        <div class="hero-bottom reveal">
          <p>
            I’m Aaron, a software engineer working across systems integration,
            data products, and embedded experiences.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="https://github.com/aaronyangello" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="work-section" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">01 / Selected work</p>
            <h2 id="work-title">Projects with range.</h2>
          </div>
          <p>From real-world integrations to odd, ambitious experiments—each one started with a problem worth untangling.</p>
        </div>

        <div class="featured-grid">
          <% projects.filter((project) => project.featured).forEach((project, index) => { %>
            <article class="featured-card featured-card-<%= index + 1 %> reveal-card">
              <div class="card-topline">
                <span><%= String(index + 1).padStart(2, '0') %></span>
                <span><%= project.year %></span>
              </div>
              <div class="card-visual <%= project.visualLabel ? 'card-visual-brand' : (project.image ? '' : 'card-visual-type') %>">
                <% if (project.visualLabel) { %>
                  <span class="card-brand-stripe" aria-hidden="true"></span>
                  <span class="card-brand-logo"><img src="<%= project.image %>" alt="" loading="lazy"></span>
                  <span class="card-brand-accent" aria-hidden="true"></span>
                  <span class="card-brand-label"><%= project.visualLabel %></span>
                <% } else if (project.image) { %>
                  <img src="<%= project.image %>" alt="" loading="lazy">
                <% } else { %>
                  <span aria-hidden="true"><%= project.name.charAt(0) %></span>
                <% } %>
              </div>
              <div class="card-copy">
                <div class="card-title-row">
                  <% if (project.inProgress) { %>
                    <% const titleParts = project.name.split(' '); %>
                    <% const titleTail = titleParts.pop(); %>
                    <h3>
                      <% if (titleParts.length) { %><%= titleParts.join(' ') %> <% } %><span class="title-tail"><%= titleTail %><span class="status-pill">In progress</span></span>
                    </h3>
                  <% } else { %>
                    <h3><%= project.name %></h3>
                  <% } %>
                </div>
                <p><%= project.summary %></p>
                <ul class="tech-list" aria-label="Technologies">
                  <% project.technologies.forEach((technology) => { %><li><%= technology %></li><% }) %>
                </ul>
                <div class="card-links">
                  <% if (project.repoUrl) { %><a href="<%= project.repoUrl %>" target="_blank" rel="noopener">Repository <span aria-hidden="true">↗</span></a><% } %>
                  <% if (project.demoUrl) { %><a href="<%= project.demoUrl %>" target="_blank" rel="noopener">Watch demo <span aria-hidden="true">▶</span></a><% } %>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="archive-section" id="archive" aria-labelledby="archive-title">
        <div class="section-heading archive-heading">
          <div>
            <p class="eyebrow">02 / Project archive</p>
            <h2 id="archive-title">More things I’ve built.</h2>
          </div>
          <div class="filters" aria-label="Filter projects">
            <button type="button" class="filter-button is-active" data-filter="all" aria-pressed="true">All</button>
            <button type="button" class="filter-button" data-filter="systems" aria-pressed="false">Systems</button>
            <button type="button" class="filter-button" data-filter="ai-data" aria-pressed="false">AI &amp; data</button>
            <button type="button" class="filter-button" data-filter="apps" aria-pressed="false">Apps</button>
            <button type="button" class="filter-button" data-filter="embedded" aria-pressed="false">Embedded</button>
          </div>
        </div>

        <div class="archive-list" aria-live="polite">
          <% projects.filter((project) => !project.featured).forEach((project) => { %>
            <article class="archive-row" data-category="<%= project.category %>">
              <div class="archive-year"><%= project.year %></div>
              <div class="archive-copy">
                <h3><%= project.name %></h3>
                <p><%= project.summary %></p>
              </div>
              <ul class="archive-tech" aria-label="Technologies">
                <% project.technologies.slice(0, 3).forEach((technology) => { %><li><%= technology %></li><% }) %>
              </ul>
              <div class="archive-links">
                <% if (project.repoUrl) { %><a href="<%= project.repoUrl %>" target="_blank" rel="noopener" aria-label="<%= project.name %> repository">Code <span aria-hidden="true">↗</span></a><% } %>
                <% if (project.demoUrl) { %><a href="<%= project.demoUrl %>" target="_blank" rel="noopener" aria-label="<%= project.name %> demo">Demo <span aria-hidden="true">↗</span></a><% } %>
              </div>
            </article>
          <% }) %>
        </div>
      </section>

      <section class="contact-section" aria-labelledby="contact-title">
        <p class="eyebrow">03 / Start a conversation</p>
        <h2 id="contact-title">Have a thorny problem?<br><span>I’d like to hear about it.</span></h2>
        <a class="button button-light" href="mailto:ayangello@gmail.com">ayangello@gmail.com <span aria-hidden="true">↗</span></a>
      </section>
    </main>

    <footer class="site-footer">
      <p>© <span id="current-year"></span> Aaron Yangello</p>
      <div>
        <a href="https://linkedin.com/in/aaronyangello" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/aaronyangello" target="_blank" rel="noopener">GitHub</a>
        <a href="https://huggingface.co/ayangello" target="_blank" rel="noopener">Hugging Face</a>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>
  </body>
</html>
